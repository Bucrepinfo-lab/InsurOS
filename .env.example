# ── Supabase Auth (phone OTP) ────────────────────────────────────────────────
# Unset = open dev mode, ONLY when NODE_ENV != production (local dev principal).
# A production build/run without them FAILS CLOSED (503, no dashboard).
# These are build-time values (baked into the bundle): pass as Docker/Fly build args.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service-role key — used ONLY to delete a user's own auth account
# (Play account deletion). Never expose to the browser; never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for the Supabase Send-SMS hook (Auth → Hooks → Send SMS).
SUPABASE_SEND_SMS_HOOK_SECRET=

# ── Access control ───────────────────────────────────────────────────────────
# Comma-separated E.164 phones bootstrapped as platform owner (full access).
# Everyone else lands on "Access pending" until an owner grants them a role
# (Dashboard -> Governance -> Jurisdiction Access).
PLATFORM_OWNER_PHONES=

# ── Money gate (v1: OFF) ─────────────────────────────────────────────────────
# Premium checkout (STK push) and automatic claim approval/payout run ONLY when
# this is exactly "true". Leave unset for the Play v1 staff/agency release.
PAYMENTS_ENABLED=

# ── Africa's Talking (SMS OTP + M-Pesa premiums) ─────────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_PAYMENTS_PRODUCT_NAME=
# Token you invent; append ?token=<this> to the AT payments callback URL
AT_PAYMENTS_CALLBACK_SECRET=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Unset = in-memory adapter over mock data.
DATABASE_URL=

# Claimant claim-decision messages (optional AI polish, OFF by default).
# Without these, claimants get the free deterministic English/Kiswahili template.
# CLAIM_MESSAGE_PROVIDER=anthropic enables the AI pass (needs ANTHROPIC_API_KEY);
# output is screened (no fraud wording, no invented amounts/dates) and falls back
# to the template. Never wire it per page view — call it when a notice is sent.
CLAIM_MESSAGE_PROVIDER=
CLAIM_MESSAGE_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# ── Android TWA (Google Play) ────────────────────────────────────────────────
# Served at /.well-known/assetlinks.json. Public certificate hashes, not secrets:
# the Play App Signing key AND the upload key SHA-256, comma-separated (AA:BB:…).
ANDROID_PACKAGE_NAME=com.telpen.insuros
ANDROID_CERT_FINGERPRINTS=
