# ── Supabase Auth (phone OTP) ────────────────────────────────────────────────
# Unset = open dev mode (local dev principal, full access). Set both to enable auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Shared secret for the Supabase Send-SMS hook (Auth → Hooks → Send SMS).
SUPABASE_SEND_SMS_HOOK_SECRET=

# ── Africa's Talking (SMS OTP + M-Pesa premiums) ─────────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_PAYMENTS_PRODUCT_NAME=
# Token you invent; append ?token=<this> to the AT payments callback URL
AT_PAYMENTS_CALLBACK_SECRET=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Unset = in-memory adapter over mock data.
DATABASE_URL=
