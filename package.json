{
    "name":  "insuros",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "validate":  "pnpm -r typecheck \u0026\u0026 pnpm -r build",
                    "repo:health":  "powershell -ExecutionPolicy Bypass -File scripts/repository-health.ps1",
                    "build":  "pnpm -r build",
                    "validate:domain":  "pnpm --filter @insuros/domain typecheck \u0026\u0026 pnpm --filter @insuros/mocks typecheck \u0026\u0026 pnpm --filter @insuros/services typecheck \u0026\u0026 pnpm --filter @insuros/admin build",
                    "validate:services":  "pnpm --filter @insuros/services typecheck \u0026\u0026 pnpm --filter @insuros/admin build",
                    "typecheck":  "pnpm -r typecheck",
                    "validate:admin":  "pnpm --filter @insuros/admin build",
                    "validate:ui":  "pnpm --filter @insuros/ui typecheck \u0026\u0026 pnpm --filter @insuros/admin build",
                    "dev":  "echo root ready"
                },
    "devDependencies":  {
                            "@types/react":  "^19.2.17",
                            "@types/react-dom":  "^19.2.3",
                            "typescript":  "^6.0.3"
                        }
}
